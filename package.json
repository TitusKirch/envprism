{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "envprism",
  "version": "0.3.1",
  "description": "TUI-based env file manager — refract one set of variables into many environment views.",
  "keywords": [
    "bun",
    "cli",
    "commitlint",
    "conventional-commits",
    "dependabot",
    "dotenv",
    "env",
    "husky",
    "kirchdev",
    "opentui",
    "oxfmt",
    "oxlint",
    "pnpm",
    "release-please",
    "tui"
  ],
  "homepage": "https://github.com/TitusKirch/envprism#readme",
  "bugs": {
    "url": "https://github.com/TitusKirch/envprism/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TitusKirch/envprism.git"
  },
  "bin": {
    "envprism": "./dist/bin/envprism.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config/define.d.ts",
      "import": "./dist/config/define.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm build",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "c12": "^3.3.4",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "taze": "^19.14.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "pnpm@12.2.1"
}
